{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-information-platform/contracts/questionnaire.schema.json",
  "title": "Questionnaire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "eventId",
    "schemaVersion",
    "title",
    "questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
