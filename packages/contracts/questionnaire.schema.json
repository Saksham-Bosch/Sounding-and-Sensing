{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-information-platform/contracts/questionnaire.schema.json",
  "title": "CustomizedEventInterviewQuestionnaire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questionnaire_id",
    "title",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "questionnaire_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "const": "Customized Event Interview"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "text",
        "type",
        "required",
        "allowed_input_types",
        "guidance",
        "branch_rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "OPEN_TEXT"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "allowed_input_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "audio",
              "image",
              "pdf",
              "docx",
              "pptx",
              "xlsx",
              "video",
              "url"
            ]
          }
        },
        "guidance": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch_rules": {
          "type": "array"
        }
      }
    }
  }
}
