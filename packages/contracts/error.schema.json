{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-information-platform/contracts/error.schema.json",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "correlationId",
    "fieldErrors"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "fieldErrors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldError"
      }
    }
  },
  "$defs": {
    "fieldError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "message"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
