# Example environment variables only.
# Do not place secrets, tokens, or confidential URLs in this file.

APP_ENV=
LOG_LEVEL=
STORAGE_PROVIDER=
LOCAL_EXCEL_PATH=
DATABASE_URL=

# ---- Phase 0 live test controls ----
API_TEST_ALLOW_LIVE_CALLS=
API_TEST_TIMEOUT_SECONDS=
API_TEST_MAX_RETRIES=

# ---- OCR: Azure OpenAI chat/vision model (document text extraction) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_MODEL=

# ---- STT: Azure OpenAI Whisper (audio/video transcription) ----
# Use a distinct endpoint from AZURE_OPENAI_ENDPOINT above if the Whisper
# deployment lives in a different Azure OpenAI resource.
AZURE_OPENAI_WHISPER_ENDPOINT=
# Azure AD client-credentials auth (preferred if all three are set):
AZURE_OPENAI_WHISPER_CLIENT_ID=
AZURE_OPENAI_WHISPER_TENANT_ID=
AZURE_OPENAI_WHISPER_SECRET=
# Fallback API-key auth (used only if the AAD credentials above are absent/fail):
AZURE_OPENAI_WHISPER_API=
# Optional overrides:
AZURE_OPENAI_WHISPER_DEPLOYMENT=
AZURE_OPENAI_WHISPER_API_VERSION=

# ---- External News/Research Agent (topic -> questionnaire) ----
EXTERNAL_NEWS_AGENT_ENDPOINT=
EXTERNAL_NEWS_AGENT_API_KEY=
# Optional overrides:
EXTERNAL_NEWS_AGENT_PATH=
EXTERNAL_NEWS_AGENT_AUTH_HEADER=
